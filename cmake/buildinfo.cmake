# Writes OUT (a .cc file) with the build number, commit and date, rewriting it
# only when something changed. Run at every build by the 'buildinfo' target.
execute_process(COMMAND git rev-list --count HEAD WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE count OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git status --porcelain --untracked-files=no WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if (NOT count)
    set(count "?")
endif()
if (hash AND dirty)
    set(hash "${hash}+")   # Built with uncommitted changes.
endif()
string(TIMESTAMP date "%Y-%m-%d %H:%M")
set(text "// Generated by cmake/buildinfo.cmake.
extern const char buildNumber[] = \"${count}\";
extern const char buildCommit[] = \"${hash}\";
extern const char buildDate[] = \"${date}\";
")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
